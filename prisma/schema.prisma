generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")
  VIEWER @map("viewer")
}

enum BriefVisibility {
  PRIVATE   @map("private")
  WORKSPACE @map("workspace")
  PUBLIC    @map("public")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspaces Workspace[]        @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  ownedBriefs      Brief[]            @relation("BriefOwner")
  createdBriefs    Brief[]            @relation("BriefCreator")
  ownedBriefJobs   BriefGenerationJob[] @relation("BriefJobOwner")
  createdBriefJobs BriefGenerationJob[] @relation("BriefJobCreator")
  ownedCompareReports   CompareReport[] @relation("CompareReportOwner")
  createdCompareReports CompareReport[] @relation("CompareReportCreator")
  sessions         UserSession[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members WorkspaceMember[]
  briefs  Brief[]
  briefJobs BriefGenerationJob[]
  compareReports CompareReport[]
  sessions UserSession[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@index([role])
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  tokenHash   String   @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Brief {
  id             String   @id
  ownerSessionId String?
  ownerId        String?
  workspaceId    String?
  createdByUserId String?
  visibility     BriefVisibility @default(PRIVATE)
  query          String
  outputLanguage String
  generatedAt    DateTime
  title          String
  tldr           String
  briefJson      Json

  totalFound Int
  totalUsed  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  papers BriefPaper[]
  owner  User?      @relation("BriefOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("BriefCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerSessionId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([visibility])
}

model BriefGenerationJob {
  id              String   @id
  status          String
  stage           String?
  stageStartedAt  DateTime?
  ownerSessionId  String?
  ownerId         String?
  workspaceId     String?
  createdByUserId String?
  visibility      BriefVisibility @default(PRIVATE)
  requestJson     Json
  briefId         String?
  error           String?
  qualityGateJson Json?
  attemptCount    Int      @default(0)
  maxAttempts     Int      @default(2)
  lockedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner     User?      @relation("BriefJobOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("BriefJobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([ownerSessionId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([visibility])
  @@index([lockedAt])
  @@index([createdAt])
}

model CompareReport {
  id              String   @id
  ownerSessionId  String?
  ownerId         String?
  workspaceId     String?
  createdByUserId String?
  visibility      BriefVisibility @default(PRIVATE)
  title           String
  summary         String
  sourceDocumentId String?
  claimCount      Int
  requestJson     Json
  reportJson      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner     User?      @relation("CompareReportOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("CompareReportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerSessionId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([visibility])
  @@index([createdAt])
}

model Paper {
  id                         String    @id
  title                      String
  abstract                   String?
  authorsJson                Json
  year                       Int?
  publishedAt                DateTime?
  doi                        String?
  arxivId                    String?
  semanticScholarId          String?
  openAlexId                 String?
  sourceUrlsJson             Json
  pdfUrl                     String?
  venue                      String?
  citationCount              Int?
  influentialCitationCount   Int?
  source                     String
  normalizedTitle            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  briefs BriefPaper[]
  fullText PaperFullText?
  textChunks PaperTextChunk[]

  @@index([doi])
  @@index([arxivId])
  @@index([semanticScholarId])
  @@index([openAlexId])
  @@index([normalizedTitle])
}

model PaperFullText {
  id           String   @id @default(cuid())
  paperId      String   @unique
  status       String
  sourceType   String
  sourceUrl    String?
  parserName   String?
  textHash     String?
  extractedAt  DateTime?
  errorMessage String?
  qualityScore Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paper  Paper            @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunks PaperTextChunk[]

  @@index([status])
  @@index([sourceType])
}

model PaperTextChunk {
  id            String   @id
  paperId       String
  fullTextId    String
  sectionTitle  String?
  chunkIndex    Int
  text          String
  tokenEstimate Int
  pageStart     Int?
  pageEnd       Int?
  createdAt     DateTime @default(now())

  paper    Paper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  fullText PaperFullText @relation(fields: [fullTextId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([fullTextId])
  @@unique([fullTextId, chunkIndex])
}

model BriefPaper {
  id String @id @default(cuid())

  briefId String
  paperId String

  relevanceScore       Float?
  citationScore        Float?
  recencyScore         Float?
  completenessScore    Float?
  sourceQualityScore   Float?
  identifierScore      Float?
  qualityScore         Float?
  finalScore           Float?
  usedInBrief          Boolean @default(true)

  brief Brief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([briefId, paperId])
}

model ApiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  source    String
  query     String
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model SourceDiagnostic {
  id          String   @id @default(cuid())
  source      String
  query       String
  status      String
  resultCount Int
  cached      Boolean
  message     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

model AiSynthesisDiagnostic {
  id           String   @id
  query        String
  provider     String
  status       String
  attemptCount Int
  paperCount   Int
  message      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
  @@index([status])
}

model UserDocument {
  id             String   @id @default(cuid())
  ownerId        String?
  workspaceId    String?
  sessionId      String?
  filename       String
  mimeType       String
  sizeBytes      Int
  status         String
  textHash       String?
  privacyScope   String
  errorMessage   String?
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  chunks UserDocumentChunk[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

model UserDocumentChunk {
  id             String @id
  documentId     String
  ownerId        String?
  workspaceId    String?
  sessionId      String?
  sectionTitle   String?
  chunkIndex     Int
  text           String
  tokenEstimate  Int
  pageStart      Int?
  pageEnd        Int?
  embeddingJson  Json?
  embeddingModel String?
  createdAt      DateTime @default(now())

  document UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([sessionId])
}
