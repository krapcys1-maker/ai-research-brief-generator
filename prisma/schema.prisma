generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")
  VIEWER @map("viewer")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspaces Workspace[]        @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members WorkspaceMember[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@index([role])
}

model Brief {
  id             String   @id
  ownerSessionId String?
  query          String
  outputLanguage String
  generatedAt    DateTime
  title          String
  tldr           String
  briefJson      Json

  totalFound Int
  totalUsed  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  papers BriefPaper[]

  @@index([ownerSessionId])
}

model BriefGenerationJob {
  id              String   @id
  status          String
  stage           String?
  stageStartedAt  DateTime?
  ownerSessionId  String?
  requestJson     Json
  briefId         String?
  error           String?
  qualityGateJson Json?
  attemptCount    Int      @default(0)
  maxAttempts     Int      @default(2)
  lockedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([ownerSessionId])
  @@index([lockedAt])
  @@index([createdAt])
}

model Paper {
  id                         String    @id
  title                      String
  abstract                   String?
  authorsJson                Json
  year                       Int?
  publishedAt                DateTime?
  doi                        String?
  arxivId                    String?
  semanticScholarId          String?
  openAlexId                 String?
  sourceUrlsJson             Json
  pdfUrl                     String?
  venue                      String?
  citationCount              Int?
  influentialCitationCount   Int?
  source                     String
  normalizedTitle            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  briefs BriefPaper[]
  fullText PaperFullText?
  textChunks PaperTextChunk[]

  @@index([doi])
  @@index([arxivId])
  @@index([semanticScholarId])
  @@index([openAlexId])
  @@index([normalizedTitle])
}

model PaperFullText {
  id           String   @id @default(cuid())
  paperId      String   @unique
  status       String
  sourceType   String
  sourceUrl    String?
  parserName   String?
  textHash     String?
  extractedAt  DateTime?
  errorMessage String?
  qualityScore Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paper  Paper            @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunks PaperTextChunk[]

  @@index([status])
  @@index([sourceType])
}

model PaperTextChunk {
  id            String   @id
  paperId       String
  fullTextId    String
  sectionTitle  String?
  chunkIndex    Int
  text          String
  tokenEstimate Int
  pageStart     Int?
  pageEnd       Int?
  createdAt     DateTime @default(now())

  paper    Paper         @relation(fields: [paperId], references: [id], onDelete: Cascade)
  fullText PaperFullText @relation(fields: [fullTextId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([fullTextId])
  @@unique([fullTextId, chunkIndex])
}

model BriefPaper {
  id String @id @default(cuid())

  briefId String
  paperId String

  relevanceScore       Float?
  citationScore        Float?
  recencyScore         Float?
  completenessScore    Float?
  sourceQualityScore   Float?
  identifierScore      Float?
  qualityScore         Float?
  finalScore           Float?
  usedInBrief          Boolean @default(true)

  brief Brief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([briefId, paperId])
}

model ApiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  source    String
  query     String
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model SourceDiagnostic {
  id          String   @id @default(cuid())
  source      String
  query       String
  status      String
  resultCount Int
  cached      Boolean
  message     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

model AiSynthesisDiagnostic {
  id           String   @id
  query        String
  provider     String
  status       String
  attemptCount Int
  paperCount   Int
  message      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
  @@index([status])
}

model UserDocument {
  id             String   @id @default(cuid())
  ownerId        String?
  workspaceId    String?
  sessionId      String?
  filename       String
  mimeType       String
  sizeBytes      Int
  status         String
  textHash       String?
  privacyScope   String
  errorMessage   String?
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  chunks UserDocumentChunk[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

model UserDocumentChunk {
  id             String @id
  documentId     String
  ownerId        String?
  workspaceId    String?
  sessionId      String?
  sectionTitle   String?
  chunkIndex     Int
  text           String
  tokenEstimate  Int
  pageStart      Int?
  pageEnd        Int?
  embeddingJson  Json?
  embeddingModel String?
  createdAt      DateTime @default(now())

  document UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([sessionId])
}
